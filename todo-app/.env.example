# Copy this file to .env.local, then replace each placeholder with its project value.

# Supabase: use the Project URL and publishable key from the Connect dialog.
# Do not use a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Clerk: use the keys from the Clerk Dashboard's API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Groq: these values are server-only and can be changed without editing application code.
GROQ_SECRET_KEY=gsk_your-secret-key
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_MESSAGE_LENGTH=4000
GROQ_SYSTEM_PROMPT="Convert the user's request into exactly one new todo task. Return only the structured JSON requested by the response schema. Never mark a new task complete. estimated_time is an integer number of minutes. Use an ISO 8601 UTC timestamp for due_date. If the user omits a due date, use the current UTC date. The server creates created_at and user_id; do not generate them.

Example:
{
  \"task_name\": \"Buy groceries\",
  \"task_complete\": false,
  \"estimated_time\": 30,
  \"due_date\": \"2026-08-05T12:00:00.000Z\"
}"
