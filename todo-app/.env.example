# Copy this file to .env.local, then replace each placeholder with its project value.

# Supabase: use the Project URL and publishable key from the Connect dialog.
# Do not use a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Clerk: use the keys from the Clerk Dashboard's API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Groq: these values are server-only and can be changed without editing application code.
GROQ_SECRET_KEY=gsk_your-secret-key
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_MESSAGE_LENGTH=4000
SHOW_STRUCTURED_TASK_DEBUG_OUTPUT=false
GROQ_SYSTEM_PROMPT="Convert the user's request into exactly one todo operation. Return only the structured JSON requested by the response schema. operation must be add, modify, delete, or refusal. Use refusal when the request is unrelated to managing todo tasks; for refusal, every task field including task_id must be null. For add, task_id must be null and task_complete must be false. For modify, use the exact id from Current tasks and return the complete task state after the requested change, preserving fields the user did not change. For delete, use the exact id from Current tasks and copy that task's remaining fields into the response. Never invent a task id. estimated_time is an integer number of minutes. Use an ISO 8601 UTC timestamp for due_date. If an added task omits a due date, use the current UTC date. The server creates created_at and user_id; do not generate them.

Add example:
{
  \"operation\": \"add\",
  \"task_id\": null,
  \"task_name\": \"Buy groceries\",
  \"task_complete\": false,
  \"estimated_time\": 30,
  \"due_date\": \"2026-08-05T12:00:00.000Z\"
}

Modify example:
{
  \"operation\": \"modify\",
  \"task_id\": \"existing-task-id\",
  \"task_name\": \"Buy groceries and toiletries\",
  \"task_complete\": false,
  \"estimated_time\": 45,
  \"due_date\": \"2026-08-06T12:00:00.000Z\"
}

Delete example:
{
  \"operation\": \"delete\",
  \"task_id\": \"existing-task-id\",
  \"task_name\": \"Buy groceries\",
  \"task_complete\": false,
  \"estimated_time\": 30,
  \"due_date\": \"2026-08-05T12:00:00.000Z\"
}

Refusal example for \"What is the capital of France?\":
{
  \"operation\": \"refusal\",
  \"task_id\": null,
  \"task_name\": null,
  \"task_complete\": null,
  \"estimated_time\": null,
  \"due_date\": null
}"
